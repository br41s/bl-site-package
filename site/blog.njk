---
layout: base.njk
navActive: blog
pagination:
  data: blogPages
  size: 1
  alias: pagePosts
  addAllPagesToCollections: true
permalink: "{% if pagination.pageNumber == 0 %}/blog/index.html{% else %}/blog/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
eleventyComputed:
  title: "{% if pagination.pageNumber > 0 %}{{ site.page_blog_title or 'Blog' }} (página {{ pagination.pageNumber + 1 }}){% else %}{{ site.page_blog_title or 'Blog' }}{% endif %}"
---
<main class="site-page"><div class="site-page-inner">
  <h1 class="reveal">{{ (site.page_blog_title or "Blog") | safe }}</h1>
  {%- if site.page_blog_subtitle %}
  <p class="site-page-subtitle reveal">{{ site.page_blog_subtitle | safe }}</p>
  {%- endif %}
  <div id="blog-posts-list">
    {%- if not articles.length %}
    <p class="site-empty">Aún no hay artículos publicados.</p>
    {%- else %}
    {%- for post in pagePosts %}
    <article class="site-post-card">
      {%- if post.image_url %}
      <a href="/blog/{{ post.slug }}" class="site-post-card-media"><img src="{{ post.image_url }}" alt="{{ post.image_alt or post.title }}" loading="lazy" decoding="async"></a>
      {%- endif %}
      <h2><a href="/blog/{{ post.slug }}">{{ post.title }}</a></h2>
      {%- if post.excerpt %}
      <p>{{ post.excerpt }}</p>
      {%- endif %}
      <span class="site-post-date">{{ post.dateEs }}</span>
    </article>
    {%- endfor %}

    {%- if pagination.pages.length > 1 %}
    <nav class="pager" aria-label="Paginación del blog">
      {%- if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}" class="pager-link">← Anterior</a>
      {%- endif %}
      <span class="pager-status">Página {{ pagination.pageNumber + 1 }} de {{ pagination.pages.length }}</span>
      {%- if pagination.href.next %}
      <a href="{{ pagination.href.next }}" class="pager-link">Siguiente →</a>
      {%- endif %}
    </nav>
    {%- endif %}
    {%- endif %}
  </div>
</div></main>
