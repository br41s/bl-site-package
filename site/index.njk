---
layout: base.njk
navActive: index
---
{%- if not site.page_index_title %}
<div class="construction-wrap"><div class="construction-icon">🚧</div><h1>Página en construcción</h1><p>Estamos preparando esta página. Vuelve pronto.</p><a href="/" class="site-btn">Volver al inicio</a></div>
{%- else %}
{#
  hero_game == "1": the "Pedido a pedido" canvas (web/game/) plays behind the
  hero text and "Jugar" turns it into the game. Without JS it stays an empty
  canvas and the Jugar button stays hidden, so the hero reads as before.
#}
{%- set heroGame = site.hero_game == "1" %}
<main class="site-hero{% if site.hero_density == 'compact' %} site-hero-compact{% endif %}{% if heroGame %} site-hero-game{% endif %}"{% if heroGame %} data-hero-game data-company="{{ site.company_name | escape }}"{% endif %}>
  {%- if heroGame %}
  <canvas class="hero-game-canvas" aria-hidden="true"></canvas>
  {%- endif %}
  <div class="site-hero-inner">
  <h1 class="reveal">{{ site.page_index_title | safe }}</h1>
  {%- if site.page_index_subtitle %}
  <p class="site-hero-subtitle reveal">{{ site.page_index_subtitle | safe }}</p>
  {%- endif %}
  {%- if site.page_index_desc %}
  <p class="site-hero-desc reveal">{{ site.page_index_desc | safe }}</p>
  {%- endif %}
  <div class="site-hero-actions reveal"><a href="/productos" class="site-btn">Ver catálogo</a><a href="/contacto" class="site-btn-ghost">Contactar</a>{% if heroGame %}<button type="button" class="site-btn-ghost hero-game-play" hidden>▶ Jugar a repartir</button>{% endif %}</div>
  </div>
  {%- if heroGame %}
  <button type="button" class="hero-game-pause" aria-pressed="false" hidden>Pausar animación</button>
  <div class="hero-game-hud" tabindex="-1" aria-label="Partida en curso" hidden>
    <span class="hero-game-lives" role="img"></span>
    <span>Pedidos <b class="hero-game-served">0</b></span>
    <span>Récord <b class="hero-game-best">0</b></span>
    <button type="button" class="site-btn-ghost hero-game-exit">Salir</button>
  </div>
  <p class="hero-game-hint" hidden>Arrastra cada producto hasta la oficina que lo pide (o tócalo y luego toca la oficina). Con teclado: 1-4 eligen producto, las flechas eligen oficina e Intro entrega.</p>
  <p class="hero-game-live visually-hidden" aria-live="polite"></p>
  <div class="hero-game-over" role="dialog" aria-labelledby="hero-game-over-text" hidden>
    <p class="hero-game-over-text" id="hero-game-over-text"></p>
    <div class="site-hero-actions"><button type="button" class="site-btn hero-game-again">Otra jornada</button><button type="button" class="site-btn-ghost hero-game-leave">Salir</button></div>
  </div>
  <script type="module" src="/game/hero-game.js"></script>
  {%- endif %}
</main>
{%- if site.page_index_image %}
<section class="site-page"><div class="site-page-inner">
  <img src="{{ site.page_index_image }}" alt="{{ site.page_index_image_alt or site.page_index_title }}" class="site-page-image reveal" loading="lazy" decoding="async">
</div></section>
{%- endif %}
{%- if site.page_index_body_html %}
<section class="site-page"><div class="site-page-inner">
  <div class="site-page-body reveal">{{ site.page_index_body_html | safe }}</div>
</div></section>
{%- endif %}
{#
  Latest posts. Cards mirror the markup in site/blog.njk on purpose so the
  homepage and the blog index stay visually identical — restyle one, restyle
  both. `articles` is already sorted created_at DESC and is empty for a client
  with no published posts, so the whole section disappears on its own and
  needs no config flag.
#}
{%- if articles.length %}
<section class="site-page"><div class="site-page-inner">
  <h2 class="reveal">Últimas publicaciones</h2>
  {%- for post in articles.slice(0, 3) %}
  <article class="site-post-card">
    {%- if post.image_url %}
    <a href="/blog/{{ post.slug }}" class="site-post-card-media"><img src="{{ post.image_url }}" alt="{{ post.image_alt or post.title }}" loading="lazy" decoding="async"></a>
    {%- endif %}
    <h3><a href="/blog/{{ post.slug }}">{{ post.title }}</a></h3>
    {%- if post.excerpt %}
    <p>{{ post.excerpt }}</p>
    {%- endif %}
    <span class="site-post-date">{{ post.dateEs }}</span>
  </article>
  {%- endfor %}
  <p class="reveal"><a href="/blog" class="site-btn-ghost">Ver todas las publicaciones</a></p>
</div></section>
{%- endif %}
{%- endif %}
