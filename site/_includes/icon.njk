{#-
  Inline stroke icons for the public site (DESIGN.md §5.4). Usage:
    {% set icon = "phone" %}{% include "icon.njk" %}
  Optional: {% set iconSize = 20 %} before the include (default 18). Every icon
  is decorative; the text beside it carries the meaning, so aria-hidden is set.
  No emoji anywhere on the site: a font-rendered glyph differs per device.
-#}
{%- set s = iconSize or 18 -%}
<svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="c-icon c-icon-{{ icon }}">
{%- if icon == "arrow" -%}
<path d="M5 12h14M13 6l6 6-6 6"/>
{%- elif icon == "check" -%}
<path d="M5 12l5 5L20 7"/>
{%- elif icon == "phone" -%}
<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>
{%- elif icon == "clock" -%}
<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif icon == "pin" -%}
<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>
{%- elif icon == "calendar" -%}
<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/>
{%- elif icon == "smile" -%}
<circle cx="12" cy="12" r="9"/><path d="M8 13.5s1.5 2.5 4 2.5 4-2.5 4-2.5"/><path d="M9 9.5h.01M15 9.5h.01" stroke-width="2.6"/>
{%- elif icon == "sparkle" -%}
<path d="M12 3l2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4z"/>
{%- elif icon == "instagram" -%}
<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
{%- elif icon == "facebook" -%}
<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v6h4v-6h3l1-4h-4V8z"/>
{%- elif icon == "whatsapp" -%}
<path d="M4 20l1.3-3.8A8 8 0 1 1 8.2 19L4 20z"/><path d="M9.5 9.5c0 3 2 5 5 5l1-1.5-2-1-1 .5a4 4 0 0 1-1.5-1.5l.5-1-1-2z"/>
{%- elif icon == "theme" -%}
<circle cx="12" cy="12" r="9"/><path d="M12 3v18A9 9 0 0 0 12 3z" fill="currentColor" stroke="none"/>
{%- elif icon == "menu" -%}
<path d="M3 6h18M3 12h18M3 18h18"/>
{%- elif icon == "cart" -%}
<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
{%- elif icon == "mail" -%}
<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 8l9 6 9-6"/>
{%- elif icon == "printer" -%}
<polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>
{%- elif icon == "file" -%}
<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/>
{%- elif icon == "megaphone" -%}
<path d="M3 11v2a1 1 0 0 0 1 1h3l7 4V6L7 10H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/>
{%- elif icon == "monitor" -%}
<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
{%- elif icon == "shirt" -%}
<path d="M8 3L3 6l2 4 3-1v12h8V9l3 1 2-4-5-3a4 4 0 0 1-8 0z"/>
{%- elif icon == "desk" -%}
<rect x="3" y="4" width="18" height="10" rx="2"/><path d="M7 14v6M17 14v6"/>
{%- elif icon == "box" -%}
<path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>
{%- elif icon == "truck" -%}
<rect x="1" y="6" width="14" height="10" rx="1"/><path d="M15 9h4l3 3v4h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
{%- elif icon == "star" -%}
<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>
{%- elif icon == "shield" -%}
<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>
{%- elif icon == "chat" -%}
<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1.1-4.3A8 8 0 1 1 21 12z"/>
{%- elif icon == "pencil" -%}
<path d="M4 20l1-4L16.5 4.5a2.1 2.1 0 0 1 3 3L8 19z"/>
{%- elif icon == "search" -%}
<circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/>
{%- elif icon == "chart" -%}
<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
{%- elif icon == "globe" -%}
<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
{%- elif icon == "refresh" -%}
<path d="M20 11a8 8 0 0 0-14-4L4 9M4 4v5h5M4 13a8 8 0 0 0 14 4l2-2M20 20v-5h-5"/>
{%- elif icon == "compass" -%}
<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>
{%- elif icon == "tag" -%}
<path d="M3 12V3h9l9 9-9 9z"/><circle cx="7.5" cy="7.5" r="1"/>
{%- elif icon == "rocket" -%}
<path d="M5 15c-1 1-2 4-2 6 2 0 5-1 6-2M14 4c4 0 6 2 6 6-2 4-5 7-9 8l-5-5c1-4 4-7 8-9z"/><circle cx="15" cy="9" r="1.5"/>
{%- else -%}
<circle cx="12" cy="12" r="9"/>
{%- endif -%}
</svg>
