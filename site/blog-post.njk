---
layout: base.njk
navActive: blog
pagination:
  data: articles
  size: 1
  alias: post
permalink: "/blog/{{ post.slug }}.html"
eleventyComputed:
  title: "{{ post.title }}"
  description: "{{ post.excerpt }}"
---
{%- if post.article_ld %}
<script type="application/ld+json">{{ post.article_ld | jsonLd | safe }}</script>
{%- endif %}
{%- if post.faq_ld %}
<script type="application/ld+json">{{ post.faq_ld | jsonLd | safe }}</script>
{%- endif %}
<main class="site-page"><div class="site-page-inner site-post-content">
  <a href="/blog" class="site-back-link">← Volver al blog</a>
  <h1>{{ post.title }}</h1>
  <span class="site-post-date">{{ post.dateEs }}</span>
  {%- if post.excerpt %}
  <p class="site-post-summary">{{ post.excerpt }}</p>
  {%- endif %}
  {%- if post.image_url %}
  <img src="{{ post.image_url }}" alt="{{ post.image_alt or post.title }}" class="site-post-cover" loading="lazy" decoding="async">
  {%- endif %}
  <div class="site-post-body">{{ post.contentHtml | safe }}</div>
  {%- if post.cta_url %}
  <a href="{{ post.cta_url }}" class="site-btn site-post-cta" target="_blank" rel="noopener noreferrer">{{ post.cta_label or "Ver ficha original" }}</a>
  {%- endif %}
  {%- if post.related.length %}
  <aside class="site-related-posts">
    <h2>También te puede interesar</h2>
    <ul>
      {%- for r in post.related %}
      <li><a href="/blog/{{ r.slug }}">{{ r.title }}</a></li>
      {%- endfor %}
    </ul>
  </aside>
  {%- endif %}
</div></main>
