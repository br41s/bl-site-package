---
layout: base.njk
navActive: servicios
permalink: "/servicios.html"
---
{%- if not site.page_servicios_title %}
<div class="construction-wrap"><div class="construction-icon">{% set icon = "sparkle" %}{% set iconSize = 48 %}{% include "icon.njk" %}</div><h1>Página en construcción</h1><p>Estamos preparando esta página. Vuelve pronto.</p><a href="/" class="site-btn">Volver al inicio</a></div>
{%- else %}
<main class="site-page"><div class="site-page-inner">
  {%- if site.calida %}
  <span class="c-chip reveal">Servicios</span>
  {%- endif %}
  <h1 class="reveal">{{ site.page_servicios_title | accentWord | safe }}</h1>
  {%- if site.page_servicios_subtitle %}
  <p class="site-page-subtitle reveal">{{ site.page_servicios_subtitle | safe }}</p>
  {%- endif %}
  {%- if site.page_servicios_image %}
  <img src="{{ site.page_servicios_image }}" alt="{{ site.page_servicios_image_alt or (site.page_servicios_title | plainTitle) }}" class="site-page-image reveal" loading="lazy" decoding="async">
  {%- endif %}
  {%- if site.page_servicios_desc %}
  {%- if site.calida and site.page_servicios_cards.cards.length %}
  {%- set sections = site.page_servicios_cards %}{% set cardFallback = "number" %}
  {% include "content-sections-calida.njk" %}
  {%- else %}
  <div class="site-page-body reveal">{{ site.page_servicios_desc_html | safe }}</div>
  {%- endif %}
  {%- endif %}
</div></main>
{%- endif %}
